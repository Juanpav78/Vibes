---
import { ClientRouter, fade } from 'astro:transitions';
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShopOverlays from '../components/react/ShopOverlays';
import { getClientPlants } from '../lib/clientPlants';
import { site } from '../data/config';
import texture from '../img/ImagenFondoVibes2.jpg';

interface Props {
	title: string;
	description?: string;
}

const { title, description = site.description } = Astro.props;

// Textura de hoja para los títulos: 2.7 MB jpg -> ~60 KB webp
const textureImg = await getImage({ src: texture, width: 600, format: 'webp', quality: 45 });
const clientPlants = await getClientPlants();
const pageTitle = `${site.name} - ${title}`;
---

<!doctype html>
<html lang="en" style={`--texture: url(${textureImg.src})`}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#3B5A26" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/logoVibes_green.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<Font cssVariable="--font-title" preload />
		<Font cssVariable="--font-text" preload />
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main" transition:animate={fade({ duration: '0.35s' })}>
			<slot />
		</main>
		<Footer />
		<ShopOverlays client:only="react" plants={clientPlants} transition:persist="shop-overlays" />
	</body>
</html>

<script>
	import '../scripts/reveal';
	import '../scripts/shop-actions';
</script>

<style>
	.skip-link {
		position: fixed;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 100;
		padding: 0.6em 1em;
		background: var(--color-primary);
		color: var(--color-white);
		transform: translateY(-150%);
		transition: transform 0.2s;
	}
	.skip-link:focus {
		transform: translateY(0);
	}
</style>
