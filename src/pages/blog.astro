---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { posts, formatDate } from '../data/site';
---

<Layout title="Blog" description="Plant care guides and tips from the Vibes team: light, watering, pet-friendly plants and more.">
	<PageHero subtitle="Tips and stories from our" title="blog" text="Simple guides to keep your plants happy, written by the people who grow them." />

	<section class="section">
		<div class="contain posts">
			{
				posts.map((post, i) => (
					<article class:list={['post', { 'post--reverse': i % 2 }]} id={post.id}>
						<div class="post__media" data-reveal={i % 2 ? 'right' : 'left'}>
							<Image src={post.image} alt="" width={640} height={480} fit="cover" quality={72} />
						</div>
						<div class="post__body" data-reveal>
							<time datetime={post.date}>{formatDate(post.date)}</time>
							<h2>{post.title}</h2>
							<p class="post__excerpt">{post.excerpt}</p>
							{post.body.map((p) => <p>{p}</p>)}
						</div>
					</article>
				))
			}
		</div>
	</section>
</Layout>

<style>
	.posts {
		display: flex;
		flex-direction: column;
		gap: 5em;
	}
	.post {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 3em;
		align-items: start;
	}
	.post--reverse .post__media {
		order: 2;
	}
	.post__media {
		position: sticky;
		top: 6rem;
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-md);
	}
	.post__media img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: transform 1s var(--ease-out);
	}
	.post__media:hover img {
		transform: scale(1.05);
	}
	.post__body time {
		color: var(--color-secondary);
	}
	.post__body h2 {
		margin: 0.3em 0 0.6em;
		font-size: clamp(1.7em, 4vw, 2.4em);
		color: var(--color-primary);
	}
	.post__body p {
		color: var(--color-muted);
		font-size: 1.1em;
		line-height: 1.75;
	}
	.post__body .post__excerpt {
		color: var(--color-dark);
		font-size: 1.25em;
		border-left: 4px solid var(--color-primary);
		padding-left: 1em;
	}
	@media (max-width: 48em) {
		.post {
			grid-template-columns: 1fr;
			gap: 1.5em;
		}
		.post--reverse .post__media {
			order: 0;
		}
		.post__media {
			position: static;
		}
	}
</style>
