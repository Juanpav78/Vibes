---
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
import { getPlant } from '../data/plants';
import { formatPrice } from '../data/config';

// Orden de la cuadrícula (la 5ª ocupa dos filas)
const ids = ['philodendron-prince-of-orange', 'peace-lily', 'golden-pothos', 'zz-plant', 'fiddle-leaf-fig'];
const items = ids.map((id) => getPlant(id)!);
---

<section class="collection section">
	<p class="subtitle" data-reveal>Collection of</p>
	<h2 class="title" data-reveal>indoor plants</h2>

	<div class="contain collection__contain" data-reveal-stagger="100">
		{
			items.map((plant, i) => (
				<button
					class={`collection__img grid--${i + 1}`}
					data-plant-open={plant.id}
					data-reveal="zoom"
					aria-label={`Quick view: ${plant.name}`}
				>
					<Image
						src={plant.image}
						alt=""
						width={420}
						height={i === 4 ? 840 : 420}
						widths={i === 4 ? [300, 420, 600] : [240, 420]}
						sizes="(max-width: 48em) 50vw, 25vw"
						fit="cover"
						quality={72}
					/>
					<span class="collection__name">
						{plant.name}
						<small>{formatPrice(plant.price)}</small>
					</span>
					<span class="collection__eye">
						<Icon name="eye" size={20} />
					</span>
				</button>
			))
		}
	</div>
</section>

<style>
	.collection__contain {
		padding: 2em 1rem;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		grid-template-rows: repeat(2, 1fr);
		gap: 3em;
	}

	.grid--1 { grid-area: 1 / 1 / 2 / 2; }
	.grid--2 { grid-area: 1 / 2 / 2 / 3; }
	.grid--3 { grid-area: 2 / 1 / 3 / 2; }
	.grid--4 { grid-area: 2 / 2 / 3 / 3; }
	.grid--5 { grid-area: 1 / 3 / 3 / 4; }

	.collection__img {
		position: relative;
		overflow: hidden;
		text-align: left;
		border-radius: 2px;
		background: var(--color-shader-w);
	}
	/* sombra interior original, ahora como capa para poder animarla */
	.collection__img::after {
		content: '';
		position: absolute;
		inset: 0;
		box-shadow: inset 0px -25px 25px -20px #e3e3e3;
		transition: box-shadow 0.4s var(--ease-out);
		pointer-events: none;
	}
	.collection__img:hover::after {
		box-shadow: inset 0px -80px 60px -40px rgba(59, 90, 38, 0.85);
	}

	.collection__img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 1 / 1;
		transition: transform 0.9s var(--ease-out);
	}
	.grid--5 img {
		aspect-ratio: auto;
	}
	.collection__img:hover img {
		transform: scale(1.08);
	}

	.collection__name {
		position: absolute;
		left: 0.8em;
		bottom: 0.6em;
		z-index: 1;
		display: flex;
		flex-direction: column;
		color: var(--color-primary);
		font-size: 1.05em;
		transition:
			color 0.3s,
			transform 0.4s var(--ease-out);
	}
	.collection__name small {
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		transition:
			max-height 0.4s var(--ease-out),
			opacity 0.3s;
	}
	.collection__img:hover .collection__name {
		color: var(--color-white);
	}
	.collection__img:hover .collection__name small {
		max-height: 1.5em;
		opacity: 1;
	}
	.collection__eye {
		position: absolute;
		top: 0.8em;
		right: 0.8em;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.9);
		color: var(--color-primary);
		opacity: 0;
		transform: scale(0.6);
		transition:
			opacity 0.3s,
			transform 0.4s var(--ease-spring);
	}
	.collection__img:hover .collection__eye,
	.collection__img:focus-visible .collection__eye {
		opacity: 1;
		transform: scale(1);
	}

	@media (max-width: 48em) {
		.collection__contain {
			padding: 2em 1rem;
			grid-template-columns: repeat(2, 1fr);
			grid-template-rows: repeat(3, auto);
			gap: 6px;
		}
		.grid--1 { grid-area: 1 / 1 / 2 / 2; }
		.grid--2 { grid-area: 2 / 1 / 3 / 2; }
		.grid--3 { grid-area: 3 / 1 / 4 / 2; }
		.grid--4 { grid-area: 3 / 2 / 4 / 3; }
		.grid--5 { grid-area: 1 / 2 / 3 / 3; }
		.collection__name {
			font-size: 0.9em;
		}
	}
</style>
