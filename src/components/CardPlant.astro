---
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
import { formatPrice } from '../data/config';
import { TAG_LABELS, type Plant } from '../data/plants';

interface Props {
	plant: Plant;
}

const { plant } = Astro.props;
const badge = plant.bestSeller ? 'Best seller' : plant.isNew ? 'New' : null;
---

<article class="card" data-reveal data-tags={plant.tags.join(' ')} data-name={plant.name.toLowerCase()} data-price={plant.price}>
	<button class="card__contain--img" data-plant-open={plant.id} aria-label={`Quick view: ${plant.name}`}>
		<Image
			class="card__img"
			src={plant.image}
			alt={plant.name}
			width={480}
			height={384}
			widths={[320, 480, 720]}
			sizes="(max-width: 48em) 90vw, 22em"
			fit="cover"
			quality={72}
		/>
		{badge && <span class:list={['card__badge', { 'card__badge--new': !plant.bestSeller }]}>{badge}</span>}
		<span class="card__quick"><Icon name="eye" size={18} /> Quick view</span>
	</button>
	<div class="card__contain--info">
		<div class="card__text">
			<h3 class="card__title">{plant.name}</h3>
			<p class="card__meta">{TAG_LABELS[plant.tags[0]]}</p>
		</div>
		<p class="card__price">{formatPrice(plant.price)}</p>
	</div>
	<button class="card__add" data-add-to-cart={plant.id} data-name={plant.name} aria-label={`Add ${plant.name} to cart`}>
		<Icon name="plus" size={22} />
	</button>
</article>

<style>
	.card {
		position: relative;
		width: 100%;
		max-width: 22em;
		background-color: var(--color-white);
		border-radius: var(--radius);
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
		overflow: hidden;
		transition:
			background-color 0.4s,
			transform 0.4s var(--ease-out),
			box-shadow 0.4s var(--ease-out);
	}
	.card:hover {
		background-color: var(--color-primary);
		transform: translateY(-6px);
		box-shadow: 0 18px 36px rgba(0, 0, 0, 0.25);
	}
	.card .card__contain--img {
		position: relative;
		display: block;
		width: 100%;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-shader-w);
	}
	.card .card__img {
		width: 100%;
		aspect-ratio: 5 / 4;
		object-fit: cover;
		transition: transform 0.8s var(--ease-out);
	}
	.card:hover .card__img {
		transform: scale(1.07);
	}
	.card__badge {
		position: absolute;
		top: 0.8rem;
		left: 0.8rem;
		padding: 0.3em 0.8em;
		border-radius: 999px;
		background: var(--color-secondary);
		color: var(--color-white);
		font-size: 0.8rem;
		letter-spacing: 0.02em;
	}
	.card__badge--new {
		background: var(--color-primary);
	}
	.card__quick {
		position: absolute;
		left: 50%;
		bottom: 0.9rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.5em 1em;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.92);
		color: var(--color-primary);
		font-size: 0.9rem;
		opacity: 0;
		translate: -50% 12px;
		transition:
			opacity 0.3s,
			translate 0.4s var(--ease-out);
	}
	.card:hover .card__quick,
	.card__contain--img:focus-visible .card__quick {
		opacity: 1;
		translate: -50% 0;
	}

	.card .card__contain--info {
		padding: 0.6em 1em 0.9em;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5em;
		padding-right: 4.25rem;
	}
	.card .card__title {
		margin: 0;
		font-size: 1.4em;
	}
	.card .card__meta {
		margin: 0.1em 0 0;
		font-size: 0.9em;
		opacity: 0.7;
	}
	.card .card__title,
	.card .card__meta,
	.card .card__price {
		color: var(--color-primary);
		transition: color 0.3s;
	}
	.card .card__price {
		margin: 0;
		font-size: 1.6em;
		font-weight: 900;
		font-family: var(--font-title);
	}
	.card:hover .card__title,
	.card:hover .card__meta,
	.card:hover .card__price {
		color: var(--color-white);
	}

	.card__add {
		position: absolute;
		right: 0.9rem;
		bottom: 0.9rem;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--color-white);
		transition:
			transform 0.35s var(--ease-spring),
			background-color 0.3s,
			color 0.3s;
	}
	.card:hover .card__add {
		background: var(--color-white);
		color: var(--color-primary);
	}
	.card__add:hover {
		transform: rotate(90deg) scale(1.1);
	}
	.card__add:global(.is-added) {
		animation: added 0.6s var(--ease-spring);
	}
	@keyframes added {
		30% {
			transform: scale(0.8);
		}
		60% {
			transform: scale(1.2);
		}
	}
</style>
