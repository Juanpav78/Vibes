---
import logo from '../img/logoVibes_green.svg';
import CartButton from './react/CartButton';
import { navLinks } from '../data/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header" transition:animate="none">
	<div class="contain header__bar">
		<a class="logo" href="/" aria-label="Vibes — home">
			<img class="logo__img" src={logo.src} alt="Vibes" width="100" height="100" />
		</a>

		<nav class="nav" id="main-nav" aria-label="Main">
			{
				navLinks.map(({ href, label }, i) => (
					<a
						class:list={['nav__link', { active: pathname === href }]}
						aria-current={pathname === href ? 'page' : undefined}
						href={href}
						style={`--i: ${i}`}
					>
						{label}
					</a>
				))
			}
		</nav>

		<div class="header__actions">
			<CartButton client:load transition:persist="cart-button" />
			<button class="menu-btn" aria-controls="main-nav" aria-expanded="false" aria-label="Open menu">
				<span></span><span></span><span></span>
			</button>
		</div>
	</div>
</header>

<script>
	const getHeader = () => document.querySelector<HTMLElement>('.header');

	function setOpen(open: boolean) {
		const header = getHeader();
		const btn = header?.querySelector<HTMLButtonElement>('.menu-btn');
		if (!header || !btn) return;
		header.classList.toggle('is-open', open);
		btn.setAttribute('aria-expanded', String(open));
		btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	}

	const onScroll = () => getHeader()?.classList.toggle('is-scrolled', window.scrollY > 8);

	// Listeners globales: una sola vez
	window.addEventListener('scroll', onScroll, { passive: true });
	document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

	// Listeners del header: en cada navegación (el header se reemplaza)
	document.addEventListener('astro:page-load', () => {
		const header = getHeader();
		header?.querySelector('.menu-btn')?.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
		header?.querySelectorAll('.nav__link').forEach((a) => a.addEventListener('click', () => setOpen(false)));
		onScroll();
	});
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: saturate(1.4) blur(10px);
		transition:
			box-shadow 0.3s,
			background-color 0.3s;
	}
	.header.is-scrolled {
		box-shadow: 0 6px 24px rgba(36, 56, 22, 0.08);
	}
	.header__bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5em;
		height: var(--header-h);
		transition: height 0.3s var(--ease-out);
	}
	.is-scrolled .header__bar {
		height: 4rem;
	}
	.logo {
		width: 6.2em;
		height: 100%;
		display: flex;
		align-items: center;
		margin-right: auto;
	}
	.logo .logo__img {
		width: 100%;
		height: auto;
		/* el svg es cuadrado con mucho aire: lo recortamos */
		aspect-ratio: 2.6 / 1;
		object-fit: cover;
		transition: transform 0.4s var(--ease-spring);
	}
	.logo:hover .logo__img {
		transform: rotate(-3deg) scale(1.05);
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 2em;
	}
	.nav .nav__link {
		position: relative;
		color: var(--color-dark);
		padding: 0.4em 0;
		transition: color 0.25s;
	}
	.nav .nav__link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -2px;
		height: 4px;
		background: var(--color-primary);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.4s var(--ease-out);
	}
	.nav .nav__link:hover {
		color: var(--color-primary);
	}
	.nav .nav__link:hover::after,
	.nav .nav__link.active::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.header__actions {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.header :global(.cart-btn) {
		position: relative;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		color: var(--color-primary);
		transition:
			background-color 0.25s,
			transform 0.25s var(--ease-spring);
	}
	.header :global(.cart-btn:hover) {
		background: var(--color-mint);
		transform: scale(1.06);
	}
	.header :global(.cart-btn__badge) {
		position: absolute;
		top: 0.1rem;
		right: 0;
		min-width: 1.3rem;
		height: 1.3rem;
		padding: 0 0.3rem;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: var(--color-secondary);
		color: var(--color-white);
		font-size: 0.75rem;
		font-weight: 700;
		animation: badge-pop 0.5s var(--ease-spring);
	}
	@keyframes badge-pop {
		from {
			transform: scale(0.3);
		}
	}

	.menu-btn {
		display: none;
		width: 2.75rem;
		height: 2.75rem;
		position: relative;
	}
	.menu-btn span {
		position: absolute;
		left: 0.7rem;
		right: 0.7rem;
		height: 2px;
		border-radius: 2px;
		background: var(--color-dark);
		transition:
			transform 0.35s var(--ease-out),
			opacity 0.2s;
	}
	.menu-btn span:nth-child(1) {
		top: 0.95rem;
	}
	.menu-btn span:nth-child(2) {
		top: 1.35rem;
	}
	.menu-btn span:nth-child(3) {
		top: 1.75rem;
	}
	.is-open .menu-btn span:nth-child(1) {
		transform: translateY(0.4rem) rotate(45deg);
	}
	.is-open .menu-btn span:nth-child(2) {
		opacity: 0;
	}
	.is-open .menu-btn span:nth-child(3) {
		transform: translateY(-0.4rem) rotate(-45deg);
	}

	@media (max-width: 48em) {
		.menu-btn {
			display: block;
		}
		.nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5rem 1rem 1.25rem;
			background: var(--color-white);
			box-shadow: 0 16px 24px rgba(36, 56, 22, 0.1);
			clip-path: inset(0 0 100% 0);
			visibility: hidden;
			transition:
				clip-path 0.45s var(--ease-out),
				visibility 0s 0.45s;
		}
		.is-open .nav {
			clip-path: inset(0 0 0 0);
			visibility: visible;
			transition: clip-path 0.45s var(--ease-out);
		}
		.nav .nav__link {
			padding: 0.9em 0;
			font-size: 1.15em;
			border-bottom: 1px solid var(--color-shader-g);
			opacity: 0;
			transform: translateY(-8px);
			transition:
				opacity 0.3s,
				transform 0.4s var(--ease-out);
		}
		.is-open .nav .nav__link {
			opacity: 1;
			transform: none;
			transition-delay: calc(var(--i) * 50ms + 80ms);
		}
		.nav .nav__link::after {
			display: none;
		}
		.nav .nav__link.active {
			color: var(--color-primary);
			font-weight: 700;
		}
	}
</style>
