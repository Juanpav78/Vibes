---
import CardService from './CardService.astro';
import { services } from '../data/site';
---

<section class="services section" id="services">
	<p class="subtitle" data-reveal>Welcome to Vibes</p>
	<h2 class="title" data-reveal>what do we offer for you?</h2>

	<div class="contain services__grid" data-reveal-stagger>
		{services.map((service) => <CardService title={service.title} ico={service.icon} description={service.description} />)}
	</div>
</section>

<style>
	.services__grid {
		margin: 2em auto 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 1.5em;
	}
</style>
