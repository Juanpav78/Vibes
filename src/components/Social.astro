---
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
import { socials } from '../data/site';
import { plants } from '../data/plants';
import blogImg from '../img/blog.jpg';

const gallery = [...plants.map((p) => ({ src: p.image, alt: p.name })), { src: blogImg, alt: 'Watering plants by the window' }];
const likes = ['1.2k', '864', '2.4k', '991', '1.7k', '640', '1.1k'];
---

<section class="social section section--soft" id="social">
	<p class="subtitle" data-reveal>Or in our</p>
	<h2 class="title" data-reveal>Social Networks</h2>
	<p class="lead" data-reveal>Daily care tips, new arrivals and a lot of green inspiration. Tag us with <strong>#VibesAtHome</strong>.</p>

	<div class="contain">
		<ul class="social__networks" data-reveal-stagger role="list">
			{
				socials.map((s) => (
					<li data-reveal>
						<a class={`network network--${s.icon}`} href={s.url} target="_blank" rel="noopener noreferrer">
							<span class="network__icon">
								<Icon name={s.icon} size={26} />
							</span>
							<span class="network__info">
								<strong>{s.name}</strong>
								<span>{s.handle}</span>
							</span>
							<span class="network__count">
								<strong>{s.followers}</strong>
								<span>followers</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<div class="social__feed" data-reveal-stagger="70">
			{
				gallery.map((item, i) => (
					<a class="post" href={socials[0].url} target="_blank" rel="noopener noreferrer" data-reveal="zoom" aria-label={`Instagram post: ${item.alt}`}>
						<Image src={item.src} alt={item.alt} width={300} height={300} fit="cover" quality={65} />
						<span class="post__overlay">
							<Icon name="instagram" size={26} />
							<span>♥ {likes[i % likes.length]}</span>
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.social__networks {
		list-style: none;
		padding: 0;
		margin: 2.5em 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 1em;
	}
	.network {
		--brand: var(--color-primary);
		display: flex;
		align-items: center;
		gap: 0.9em;
		padding: 1em 1.2em;
		border-radius: var(--radius);
		background: var(--color-white);
		box-shadow: var(--shadow-sm);
		color: var(--color-dark);
		transition:
			transform 0.4s var(--ease-out),
			box-shadow 0.4s,
			background-color 0.4s,
			color 0.4s;
	}
	.network--instagram { --brand: #c13584; }
	.network--facebook { --brand: #1877f2; }
	.network--youtube { --brand: #e62117; }
	.network--twitter { --brand: #1d9bf0; }

	.network:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-md);
		background: var(--color-primary);
		color: var(--color-white);
	}
	.network__icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		background: var(--color-mint);
		color: var(--brand);
		transition: transform 0.5s var(--ease-spring);
	}
	.network:hover .network__icon {
		transform: rotate(-12deg) scale(1.1);
		background: var(--color-white);
	}
	.network__info,
	.network__count {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}
	.network__info span,
	.network__count span {
		font-size: 0.85em;
		opacity: 0.7;
	}
	.network__count {
		margin-left: auto;
		text-align: right;
	}
	.network strong {
		font-family: var(--font-title);
	}

	.social__feed {
		margin-top: 2em;
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 0.5em;
	}
	.post {
		position: relative;
		overflow: hidden;
		border-radius: 4px;
		aspect-ratio: 1;
	}
	.post img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.8s var(--ease-out);
	}
	.post:hover img {
		transform: scale(1.12);
	}
	.post__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.3em;
		color: var(--color-white);
		background: rgba(36, 56, 22, 0.6);
		opacity: 0;
		transition: opacity 0.35s;
	}
	.post:hover .post__overlay,
	.post:focus-visible .post__overlay {
		opacity: 1;
	}

	@media (max-width: 64em) {
		.social__feed {
			grid-template-columns: repeat(4, 1fr);
		}
		.post:nth-child(n + 5) {
			display: none;
		}
	}
	@media (max-width: 48em) {
		.social__feed {
			grid-template-columns: repeat(3, 1fr);
		}
		.post:nth-child(n + 4) {
			display: none;
		}
	}
</style>
